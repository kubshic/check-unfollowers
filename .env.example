# ── DB (Turso) ───────────────────────────────
# 로컬 개발은 비워두면 data/app.db 파일을 쓴다.
# Vercel의 Turso 연동을 쓰면 TURSO_DATABASE_URL / TURSO_AUTH_TOKEN 이름으로 들어와도 인식한다.
DATABASE_URL=libsql://your-db.turso.io
DATABASE_AUTH_TOKEN=

# ── 로그인 (Better Auth) ─────────────────────
# 32자 이상 임의 문자열. 생성: npx @better-auth/cli secret  또는  openssl rand -base64 32
BETTER_AUTH_SECRET=
# 사이트 주소. Vercel에선 비워두면 프로덕션 도메인을 자동으로 쓴다.
BETTER_AUTH_URL=https://your-domain.vercel.app

# ── 메일 (Resend) : 이메일 인증, 비밀번호 재설정 ──
# 비워두면 로컬에선 메일 대신 서버 로그에 링크를 찍는다.
RESEND_API_KEY=
EMAIL_FROM=맞팔체크 <no-reply@your-domain.com>

# ── Google 로그인 (선택) ─────────────────────
# 승인된 리디렉션 URI: https://your-domain/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
